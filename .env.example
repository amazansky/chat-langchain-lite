# Copy this file to .env and fill in your values

# LangSmith
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=chat-langchain-lite
LANGSMITH_WORKSPACE_ID=your-demo-workspace-id
LANGSMITH_API_KEY_GATEWAY=your-demo-gateway-key

DEMO_PRESENTER="robert"

# Fallback model — a second, independently-credentialed path used when the
# gateway model in utils/models.py MODEL_CONFIG fails (bad credentials, denied
# permission, unknown model id). Without a key here a gateway fault has no
# second path and the request fails.
# OPENAI_API_KEY=sk-...
# CHAT_LANGCHAIN_LITE_FALLBACK_MODEL=gpt-4.1-mini
# CHAT_LANGCHAIN_LITE_FALLBACK_PROVIDER=openai
# CHAT_LANGCHAIN_LITE_FALLBACK_API_KEY_ENV=OPENAI_API_KEY

# Set to false to import utils.models without probing the gateway at startup
# (offline dev / unit tests). Leave on so misconfiguration fails at startup
# rather than on every user request.
# CHAT_LANGCHAIN_LITE_VALIDATE_MODEL=true

# FastHTML frontend (optional)
# Base URL the frontend uses to reach the co-located graph over the LangGraph
# SDK. Must be loopback. Defaults to the `langgraph dev` port; set to
# http://localhost:8000 in a deployment (the container's API port).
# LANGGRAPH_API_URL=http://localhost:2024

# Secret used to sign the session cookie that holds the chat thread id.
# Set this in any real deployment so sessions survive a restart.
# SESSION_SECRET=change-me-in-production
